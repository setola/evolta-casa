# Compose interpolation only. Copy to .env and fill using `id -u` / `id -g`,
# or export LOCAL_UID and LOCAL_GID in your shell (these override .env).
LOCAL_UID=
LOCAL_GID=
# Published on ALL host interfaces: allow only trusted LAN clients in the firewall.
APP_PORT=5173
# Reachable VM hostname (configure LAN DNS/hosts), no scheme or port.
# An IPv4 address is also supported. For TLS use this exact canonical name/IP.
DEV_HOST=evolta-casa.local
# Optional additional trusted hostnames, comma-separated; IPs work automatically.
DEV_ALLOWED_HOSTS=
# Optional `tls` profile (containerized Caddy/local CA).
TLS_PORT=8443

# Optional PUBLIC browser keys: export on the host (forwarded to web/npm),
# define in the ignored .env, or let Vite load .env.local from the source mount.
# Leave commented if using .env.local: an exported empty value overrides dotenv.
# VITE_GOOGLE_MAPS_API_KEY=replace-with-public-browser-key
# VITE_GOOGLE_MAPS_PLACES_API_KEY=replace-with-public-browser-key
# VITE_GOOGLE_MAPS_JS_API_KEY=replace-with-public-browser-key
